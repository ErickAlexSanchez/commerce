{
  "name": "vesper-counsel",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @vesper-counsel/commerce --filter @vesper-counsel/vesper --filter @vesper-counsel/counsel dev",
    "typecheck": "pnpm --filter @vesper-counsel/catalog build && pnpm --filter @vesper-counsel/commerce --filter @vesper-counsel/vesper --filter @vesper-counsel/counsel typecheck",
    "lint": "eslint .",
    "test": "pnpm --filter @vesper-counsel/catalog build && pnpm --filter @vesper-counsel/commerce test && pnpm --filter @vesper-counsel/vesper test && pnpm --filter @vesper-counsel/counsel test",
    "e2e": "playwright test",
    "db:migrate": "pnpm --filter @vesper-counsel/commerce migrate",
    "db:seed": "pnpm --filter @vesper-counsel/commerce seed"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
